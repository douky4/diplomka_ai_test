# Produkce (Render): Supabase Session pooler connection string (IPv4, port 5432).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require

# Nastavte na vlastní dlouhé náhodné heslo. Nikdy ho necommitujte.
ADMIN_PASSWORD=change-me

# GitHub Pages + Supabase: these two values are PUBLIC browser configuration.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# A legacy SUPABASE_ANON_KEY JWT may be used instead of the publishable key.
# Never use service_role or sb_secret_ keys here.
